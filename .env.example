# Custom domain
APP_URL=localhost:3000

# Contact form — Resend (https://resend.com). All three are required before
# the form can deliver; without them it renders its error state and logs why.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the messages land. Never sent to the browser — the server action is
# the only thing that reads it.
CONTACT_TO=***@***

# Who they come from. Must be an address on a domain verified in Resend;
# onboarding@resend.dev works with no DNS setup but only ever delivers to
# the address that owns the Resend account.
CONTACT_FROM="Portfolio <***@***>"
