{
  "name": "portfolio",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm run registry:build && next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:report": "eslint -f json -o eslint-report.json",
    "prepare": "husky",
    "registry:build": "shadcn build",
    "registry:check": "node scripts/check-registry.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "1.3.1",
    "@vercel/speed-insights": "^1.3.1",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "16.0.7",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "postcss": "^8.5",
    "prettier": "^3.9.6",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
