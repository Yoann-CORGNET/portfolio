# Pre-push: whole-project type-check and lint. Blocks the push on failure.
# set -e ensures a typecheck failure aborts before lint runs (and blocks).
# lint-staged only sees staged files at commit time, so this is what catches
# a change that breaks a file you did not touch.
set -e

pnpm run typecheck
pnpm run lint
# Registry completeness: a component in the barrel but not in registry.json
# ships a broken `shadcn add`. Deterministic and offline (plain file reads), so
# it front-runs the CI check here instead of only failing after a push.
pnpm run registry:check
